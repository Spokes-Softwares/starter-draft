{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    },
    "strictNullChecks": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    "next.config.js",
    ".next/types/**/*.ts",
    "components/tenants-table/columns.tsx",
    "components/tenants-table/features.ts",
    "components/tenants-table/filtering.tsx",
    "components/tenants-table/pagination.tsx",
    "components/tenants-table/row-actions.tsx",
    "components/tenants-table/table.tsx",
    "../../packages/db/src/actions/hub-onboarding-action.ts",
    "../../packages/db/src/actions/tenant-onboard-action.integration.test.ts",
    "../../packages/db/src/actions/tenant-onboard-action.ts"
  ],
  "exclude": ["node_modules"]
}
