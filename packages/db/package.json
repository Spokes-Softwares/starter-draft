{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./client": "./src/client.ts",
    "./server": "./src/server.ts",
    "./admin": "./src/admin.ts",
    "./middleware": "./src/middleware.ts",
    "./types": "./src/types.ts",
    "./resolve-account": "./src/resolve-account.ts",
    "./actions/*": "./src/actions/*.ts"
  },
  "scripts": {
    "dev": "supabase start",
    "migration:new": "supabase migration new",
    "migration:push": "supabase db push",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "gen-types": "supabase gen types typescript --local > src/types.ts"
  },
  "dependencies": {
    "@supabase/ssr": "catalog:",
    "@supabase/supabase-js": "catalog:",
    "next": "catalog:",
    "vitest": "catalog:"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
}
