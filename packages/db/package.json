{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./client": "./src/client.ts",
    "./server": "./src/server.ts",
    "./admin": "./src/admin.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "dev": "supabase start",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "gen-types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID > src/types.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "next": "16.3.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@supabase/ssr": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
}