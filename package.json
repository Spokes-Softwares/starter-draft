{
  "name": "spokes-turbo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "db:start": "supabase start --workdir packages/db",
    "db:stop": "supabase stop --workdir packages/db",
    "db:gen-types": "supabase gen types --local --workdir packages/db > packages/db/src/types.ts",
    "db:migration:new": "pnpm --filter @repo/db migration:new",
    "db:migration:push": "pnpm --filter @repo/db migration:push",
    "db:reset": "pnpm --filter @repo/db seed:assets:generate && supabase db reset --workdir packages/db",
    "pr:check": "pnpm lint && pnpm format && pnpm check-types",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css,mjs}\"",
    "check-types": "turbo run check-types",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --ui"
  },
  "dependancies": {
    "vitest": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "^22.20.2",
    "prettier": "catalog:",
    "supabase": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@faker-js/faker": "catalog:",
    "@hookform/resolvers": "catalog:",
    "lucide-react": "catalog:",
    "next-themes": "catalog:",
    "react-hook-form": "catalog:",
    "zod": "catalog:"
  },
  "packageManager": "pnpm@12.3.4"
}
