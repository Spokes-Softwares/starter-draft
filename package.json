{
  "name": "spokes-turbo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "db:start": "supabase start --workdir packages/db",
    "db:stop": "supabase stop --workdir packages/db",
    "db:gen-types": "supabase gen types --local --workdir packages/db > packages/db/src/types.ts",
    "db:migration:new": "pnpm --filter @repo/db migration:new",
    "db:migration:push": "pnpm --filter @repo/db migration:push",
    "db:reset": "supabase db reset --workdir packages/db",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css,mjs}\"",
    "check-types": "turbo run check-types",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "prettier": "catalog:",
    "supabase": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "next-themes": "catalog:"
  },
  "packageManager": "pnpm@10.15.0"
}