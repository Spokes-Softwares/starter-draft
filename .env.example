# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: remote type generation
SUPABASE_PROJECT_ID=your-project-id

# Local multi-port dev only (`pnpm dev`). Each value is that app's origin.
# Leave these unset on Vercel. The deployment host routes /auth, /docs,
# /operations, /tenant, and /hubs, and preview URLs stay on the preview host.
# AUTH_URL=http://localhost:3010
# OPERATIONS_URL=http://localhost:3000
# TENANT_URL=http://localhost:3001
# HUB_URL=http://localhost:3002
